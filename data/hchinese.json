    "poem": {
      "title": "古诗文默写与赏析",
      "groups": [
        {
          "id": "hp_g1",
          "title": "必背名篇（理解性默写）",
          "poems": [
            {
              "id": "hp_001",
              "title": "劝学（节选）",
              "dynasty": "先秦·荀子",
              "author": "荀子",
              "lines": [
                "君子曰：学不可以已。",
                "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。",
                "故木直中绳，輮以为轮，其曲中规。",
                "故木受绳则直，金就砺则利。",
                "君子博学而日参省乎己，则知明而行无过矣。"
              ],
              "notes": [
                "青：形容词使动活用，指使……变青。",
                "輮：弯曲，动词使动。",
                "中：合、符合。",
                "参省：检验反省。"
              ]
            },
            {
              "id": "hp_002",
              "title": "师说（节选）",
              "dynasty": "唐·韩愈",
              "author": "韩愈",
              "lines": [
                "古之学者必有师。",
                "师者，所以传道受业解惑也。",
                "是故无贵无贱，无长无少，道之所存，师之所存也。",
                "吾师道也，夫庸知其年之先后生于吾乎？",
                "是故弟子不必不如师，师不必贤于弟子。"
              ],
              "notes": [
                "所以：用来……的。",
                "受：通“授”，传授。",
                "道：道理，这里指儒家的道统。",
                "庸知：岂知。"
              ]
            },
            {
              "id": "hp_003",
              "title": "赤壁赋（节选）",
              "dynasty": "宋·苏轼",
              "author": "苏轼",
              "lines": [
                "清风徐来，水波不兴。",
                "举酒属客，诵明月之诗，歌窈窕之章。",
                "白露横江，水光接天。纵一苇之所如，凌万顷之茫然。",
                "寄蜉蝣于天地，渺沧海之一粟。",
                "挟飞仙以遨游，抱明月而长终。"
              ],
              "notes": [
                "属：通“嘱”，劝酒。",
                "一苇：像苇叶一样的小船。",
                "如：往、到。",
                "凌：凌越、渡。"
              ]
            },
            {
              "id": "hp_004",
              "title": "念奴娇·赤壁怀古（节选）",
              "dynasty": "宋·苏轼",
              "author": "苏轼",
              "lines": [
                "大江东去，浪淘尽，千古风流人物。",
                "故垒西边，人道是，三国周郎赤壁。",
                "乱石穿空，惊涛拍岸，卷起千堆雪。",
                "江山如画，一时多少豪杰。",
                "羽扇纶巾，谈笑间，樯橹灰飞烟灭。"
              ],
              "notes": [
                "淘尽：冲刷干净。",
                "故垒：古垒。",
                "穿空：插入天空。",
                "樯橹：借指战船。"
              ]
            }
          ]
        },
        {
          "id": "hp_g2",
          "title": "必背名句（直接默写）",
          "poems": [
            {
              "id": "hp_005",
              "title": "琵琶行（节选）",
              "dynasty": "唐·白居易",
              "author": "白居易",
              "lines": [
                "大弦嘈嘈如急雨，小弦切切如私语。",
                "嘈嘈切切错杂弹，大珠小珠落玉盘。",
                "间关莺语花底滑，幽咽泉流冰下难。",
                "别有幽愁暗恨生，此时无声胜有声。"
              ],
              "notes": [
                "大弦、小弦：粗弦、细弦。",
                "间关：鸟鸣婉转。",
                "幽咽：形容声音低微、哽咽。"
              ]
            },
            {
              "id": "hp_006",
              "title": "登高（节选）",
              "dynasty": "唐·杜甫",
              "author": "杜甫",
              "lines": [
                "风急天高猿啸哀，渚清沙白鸟飞回。",
                "无边落木萧萧下，不尽长江滚滚来。",
                "万里悲秋常作客，百年多病独登台。",
                "艰难苦恨繁霜鬓，潦倒新停浊酒杯。"
              ],
              "notes": [
                "渚：水中小洲。回：盘旋。",
                "落木：落叶。",
                "百年：指一生。",
                "新停：刚刚停止（因病戒酒）。"
              ]
            },
            {
              "id": "hp_007",
              "title": "离骚（节选）",
              "dynasty": "战国·屈原",
              "author": "屈原",
              "lines": [
                "长太息以掩涕兮，哀民生之多艰。",
                "路漫漫其修远兮，吾将上下而求索。",
                "亦余心之所善兮，虽九死其犹未悔。"
              ],
              "notes": [
                "太息：叹息。",
                "民生：百姓的生计。",
                "修远：路途遥远。",
                "九死：多次经历死亡。"
              ]
            },
            {
              "id": "hp_008",
              "title": "逍遥游（节选）",
              "dynasty": "先秦·庄子",
              "author": "庄子",
              "lines": [
                "北冥有鱼，其名为鲲。鲲之大，不知其几千里也。化而为鸟，其名为鹏。",
                "鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。",
                "且夫水之积也不厚，则其负大舟也无力。"
              ],
              "notes": [
                "冥：海。",
                "抟：旋转上升。",
                "扶摇：直上。",
                "负：承载。"
              ]
            },
            {
              "id": "hp_009",
              "title": "蜀道难（节选）",
              "dynasty": "唐·李白",
              "author": "李白",
              "lines": [
                "噫吁嚱，危乎高哉！蜀道之难，难于上青天！",
                "蚕丛及鱼凫，开国何茫然！",
                "地崩山摧壮士死，然后天梯石栈相钩连。",
                "尔来四千万年，不闻秦汉之遗风。"
              ],
              "notes": [
                "噫吁嚱：叹词。危：高。",
                "蚕丛、鱼凫：传说中蜀国先王。",
                "钩连：连接。",
                "遗风：遗留下的风俗。"
              ]
            },
            {
              "id": "hp_010",
              "title": "永遇乐·京口北固亭怀古（节选）",
              "dynasty": "宋·辛弃疾",
              "author": "辛弃疾",
              "lines": [
                "千古江山，英雄无觅，孙仲谋处。",
                "想当年，金戈铁马，气吞万里如虎。",
                "凭谁问：廉颇老矣，尚能饭否？"
              ],
              "notes": [
                "觅：寻找。",
                "孙仲谋：孙权。",
                "金戈铁马：形容战争。",
                "饭否：廉颇尚能饭否，表示还能否被重用。"
              ]
            }
          ]
        }
      ]
    },
    "guwen": {
      "title": "文言文阅读",
      "groups": [
        {
          "id": "hg_g1",
          "title": "高频篇目精讲",
          "passages": [
            {
              "id": "hg_001",
              "title": "师说（节选）",
              "source": "唐·韩愈《师说》",
              "lines": [
                "古之学者必有师。师者，所以传道受业解惑也。",
                "人非生而知之者，孰能无惑？惑而不从师，其为惑也，终不解矣。",
                "是故无贵无贱，无长无少，道之所存，师之所存也。",
                "嗟乎！师道之不传也久矣！欲人之无惑也难矣！",
                "爱其子，择师而教之；于其身也，则耻师焉惑矣。",
                "是故弟子不必不如师，师不必贤于弟子，闻道有先后，术业有专攻，如是而已。"
              ],
              "zhushi": {
                "所以": "用来……的",
                "受": "通“授”，传授",
                "惑": "疑惑",
                "闻道": "懂得道理",
                "术业": "学术和技艺",
                "攻": "专攻、精通"
              },
              "fanyi": "古代求学的人一定要有老师。老师是靠他来传授道理、教授学业、解答疑难问题的人。人不是生下来就懂得道理的，谁能没有疑惑？有疑惑却不跟从老师学习，那真是有疑惑了。之所以士人身上不存在疑难问题，是因为道不存在，问题就解决了；道存在，问题就解决了。",
              "kaodian": [
                {
                  "q": "“师者，所以传道受业解惑也”中“所以”的意思是（　）",
                  "options": [
                    "因为",
                    "用来……的",
                    "所以",
                    "理由"
                  ],
                  "answer": 1,
                  "analysis": "“所以”在这里是“用来……的”，表目的或凭借。表因果译为“因为”，排除 A。"
                },
                {
                  "q": "“是故无贵无贱，无长无少”运用的论证方法是（　）",
                  "options": [
                    "比喻论证",
                    "对比论证",
                    "举例论证",
                    "道理论证"
                  ],
                  "answer": 1,
                  "analysis": "以“无贵无贱，无长无少”作对比，论证师道不分贵贱长幼，属对比论证。"
                }
              ]
            },
            {
              "id": "hg_002",
              "title": "赤壁赋（节选）",
              "source": "宋·苏轼《赤壁赋》",
              "lines": [
                "时夜将半，四顾寂寥。适有孤鹤，横江东来。",
                "翅如车轮，玄裳缟衣，戛然长鸣，掠舟而西也。",
                "须臾，客去，予亦就睡。梦一道士，羽衣蹁跹，过临皋之下，揖予而言曰：“赤壁之游乐乎？”",
                "问其姓名，俯而不答。“呜呼噫嘻！我知之矣。畴昔之夜，飞鸣而过我者，非子也邪？”",
                "道士顾笑，予亦惊寤。开户视之，不见其处。"
              ],
              "zhushi": {
                "适": "恰好",
                "裳": "读 cháng，衣饰",
                "戛然": "形容声音响亮",
                "就睡": "就卧、睡觉",
                "蹁跹": "旋转飞舞",
                "畴昔": "前日、昨天",
                "寤": "睡醒"
              },
              "fanyi": "时间将近半夜了，我四周看看，寂静空旷。恰好有一只孤鹤，横着江面从东边飞来。翅膀像车轮，羽毛雪白，衣饰洁白，发出一声尖锐的长鸣，掠过船边向西飞去。不久，客人离开了，我也去睡觉了。梦中见到一道士，穿着羽衣旋转跳舞，经过临皋之下，向我作揖说：“赤壁之游快乐吗？”我问他的姓名，他俯下身子不回答。我知道是谁了，说：“噫嘻噫！我知道了，昨晚飞鸣着经过我的人，不是你吗？”道士回头笑了，我于是惊醒，开门看，却不见了。",
              "kaodian": [
                {
                  "q": "“适有孤鹤，横江东来”中“适”的意思是（　）",
                  "options": [
                    "适合",
                    "恰好",
                    "适应",
                    "前往"
                  ],
                  "answer": 1,
                  "analysis": "“适”作副词意为“恰好”，与下文“须臾”表时间承接一致。"
                },
                {
                  "q": "“玄裳缟衣”形容鹤的（　）",
                  "options": [
                    "鸣声响亮",
                    "颜色洁白",
                    "姿态美丽",
                    "飞行迅速"
                  ],
                  "answer": 1,
                  "analysis": "玄＝黑色（裳），缟＝白色（衣），以颜色修饰鹤，形容其羽毛黑白分明。"
                }
              ]
            },
            {
              "id": "hg_003",
              "title": "劝学（节选）",
              "source": "先秦·荀子《劝学》",
              "lines": [
                "君子曰：学不可以已。",
                "木直中绳，輮以为轮，其曲中规。虽有槁暴，不复挺者，輮使之然也。",
                "金就砺则利，君子博学而日参省乎己，则知明而行无过矣。",
                "假舆马者，非利足也，而致千里。",
