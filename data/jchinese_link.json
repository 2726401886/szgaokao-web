    {
      "id": "jl2",
      "title": "词语与成语运用",
      "grade_tag": "初一衔接",
      "summary": "初中成语题重点考查语境中的恰当使用，尤其注意褒贬色彩与适用对象。",
      "points": [
        {
          "h": "一、成语的褒贬色彩",
          "body": "褒义词如“呕心沥血”“锲而不舍”；贬义词如“处心积虑”“趋之若鹜”；中性词如“各抒己见”。",
          "eg": "“夸夸其谈”是贬义，不能用来形容精彩发言。",
          "tip": "看到成语先判断感情色彩再入句。"
        },
        {
          "h": "二、适用对象",
          "body": "有些成语有固定对象，如“汗牛充栋”只形容书籍多，“巧夺天工”只形容人工（非自然）。",
          "eg": "“鳞次栉比”形容房屋等建筑物密集排列。",
          "tip": "对象错了，成语就用错了。"
        },
        {
          "h": "三、望文生义避坑",
          "body": "不可按字面猜意思，如“不刊之论”指不可更改的言论，“万人空巷”指人都出来致使街巷空了（热闹）。",
          "eg": "“首当其冲”指最先受到攻击，不是“首先”。",
          "tip": "熟记易望文生义的成语。"
        },
        {
          "h": "四、近义词辨析",
          "body": "从词义轻重、范围大小、搭配习惯区分，如“爱护/爱戴”“遏制/遏止”。",
          "eg": "“改进”重方法，“改善”重条件。",
          "tip": "把易混词成对整理记忆。"
        }
      ],
