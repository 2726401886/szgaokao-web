    {
      "id": "jl4",
      "title": "古诗文默写与赏析",
      "grade_tag": "初二衔接",
      "summary": "初中必背古诗文数量增加，默写要求准确无误，赏析要抓住名句哲理与情感。",
      "points": [
        {
          "h": "一、默写零失误",
          "body": "默写考查字形准确，尤其同音误写，如“惟”与“唯”、“沧”与“苍”。",
          "eg": "“长风破浪会有时”的“沧”勿写“苍”。",
          "tip": "默写后逐字核对原文。"
        },
        {
          "h": "二、名句理趣",
          "body": "许多名句蕴含哲理，如“海日生残夜，江春入旧年”写新旧交替；“沉舟侧畔千帆过”写新生事物胜出。",
          "eg": "“会当凌绝顶，一览众山小”抒雄心壮志。",
          "tip": "赏析结合诗句原意与普遍哲理。"
        },
        {
          "h": "三、作者与朝代",
          "body": "熟记重要诗人朝代：曹操（东汉）、王维（唐）、李白（唐）、杜甫（唐）、苏轼（宋）、马致远（元）。",
          "eg": "《天净沙·秋思》马致远，元曲。",
          "tip": "用“诗人—朝代—名篇”三栏表记忆。"
        },
        {
          "h": "四、意象与情感",
          "body": "常见意象：月（思乡）、柳（送别）、落红（奉献）、菊（隐逸）。",
          "eg": "“乡书何处达？归雁洛阳边”借雁传思乡情。",
          "tip": "积累意象词典。"
        }
