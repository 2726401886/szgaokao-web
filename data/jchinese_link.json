    {
      "id": "jl3",
      "title": "病句与标点修改",
      "grade_tag": "初二衔接",
      "summary": "病句六大类型（成分残缺、搭配不当、语序不当、句式杂糅、不合逻辑、表意不明）与常用标点，是中考稳定考点。",
      "points": [
        {
          "h": "一、成分残缺",
          "body": "常见缺主语（滥用“通过……使……”）、缺宾语。改法：删掉使令动词或补出主语。",
          "eg": "“通过这次活动，使我进步”删“使”或“通过”。",
          "tip": "看到“通过/由于/在……下+使”警惕缺主语。"
        },
        {
          "h": "二、搭配不当",
          "body": "主谓、动宾、修饰语与中心语要搭配，如“提高水平”对，“提高习惯”错。",
          "eg": "“端正态度”“养成习惯”是固定搭配。",
          "tip": "读句子抓主干（主谓宾）即可发现。"
        },
        {
          "h": "三、两面对一面",
          "body": "前面有“能否/是否”，后面要对应两面，否则犯“两面对一面”。",
          "eg": "“能否成功，关键在于努力”应改“努力”为“是否努力”。",
          "tip": "找“能否/是否/好坏”等词。"
        },
        {
          "h": "四、常用标点",
          "body": "引号、逗号、顿号、分号、问号的规范用法；提示语在前用冒号，引用完整句号在引号内。",
          "eg": "“快走！”他喊道（叹号在引号内）。",
          "tip": "无疑问的句子不用问号。"
        }
      ],
      "quiz": [
