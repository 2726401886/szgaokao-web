  "note": "初中语文六板块（覆盖初一至初三）：字词积累与运用、古诗文默写与赏析、文言文阅读、现代文阅读、名著导读、写作指导。支持认读/辨析/默写/阅读选择/考点判分等交互，浏览器朗读辅助。内容由 AI 生成，待人工校对。",
  "sections": {
    "zi": {
      "title": "字词积累与运用",
      "groups": [
        {
          "id": "jz_g1",
          "title": "字音字形（易错）",
          "words": [
            {
              "id": "jz_001",
              "word": "贮",
              "pinyin": "zhù",
              "bushou": "贝",
              "zuci": [
                "贮藏",
                "贮存"
              ],
              "juxing": "他把过冬的粮食贮存在地窖里。",
              "jieshi": "积存、收藏。注意不读 chǔ。"
            },
            {
              "id": "jz_002",
              "word": "锲",
              "pinyin": "qiè",
              "bushou": "钅",
              "zuci": [
                "锲而不舍"
              ],
              "juxing": "他锲而不舍地钻研难题。",
              "jieshi": "雕刻。与“契”区分，不读 qì。"
            },
            {
              "id": "jz_003",
              "word": "慰藉",
              "pinyin": "wèi jiè",
              "bushou": "艹",
              "zuci": [
                "慰藉",
                "安慰"
              ],
              "juxing": "书籍是孤独时最好的慰藉。",
              "jieshi": "安慰。藉读 jiè，不读 jí。"
            },
            {
              "id": "jz_004",
              "word": "炽热",
              "pinyin": "chì rè",
              "bushou": "火",
              "zuci": [
                "炽热",
                "炽烈"
              ],
              "juxing": "青年怀着炽热的理想。",
              "jieshi": "旺盛、热烈。不读 zhì。"
            },
            {
              "id": "jz_005",
              "word": "蓦然",
              "pinyin": "mò rán",
              "bushou": "艹",
              "zuci": [
                "蓦然",
                "蓦地"
              ],
              "juxing": "他蓦然回首，已物是人非。",
              "jieshi": "突然。不读 mù。"
            },
            {
              "id": "jz_006",
              "word": "亘古",
              "pinyin": "gèn gǔ",
              "bushou": "二",
              "zuci": [
                "亘古",
                "横亘"
              ],
              "juxing": "这片土地亘古以来便有先民居住。",
              "jieshi": "空间或时间上延续不断。不读 gèng。"
            },
            {
              "id": "jz_007",
              "word": "羸弱",
              "pinyin": "léi ruò",
              "bushou": "羊",
              "zuci": [
                "羸弱",
                "羸瘦"
              ],
              "juxing": "病后他显得十分羸弱。",
              "jieshi": "瘦弱。与“赢(yíng)”形近需辨析。"
            },
            {
              "id": "jz_008",
              "word": "追溯",
              "pinyin": "zhuī sù",
              "bushou": "氵",
              "zuci": [
                "追溯",
                "溯源"
              ],
              "juxing": "我们可以追溯这条河流的源头。",
              "jieshi": "逆流而上，比喻探索事物的由来。不读 shuò。"
            },
            {
              "id": "jz_009",
              "word": "祈祷",
              "pinyin": "qí dǎo",
              "bushou": "礻",
              "zuci": [
                "祈祷",
                "祈愿"
              ],
              "juxing": "人们在庙里祈祷平安。",
              "jieshi": "向神求福。祈读 qí，不读 qǐ。"
            },
            {
              "id": "jz_010",
              "word": "稽首",
              "pinyin": "qǐ shǒu",
              "bushou": "禾",
              "zuci": [
                "稽首"
              ],
              "juxing": "古籍中臣子向君王行稽首礼。",
              "jieshi": "古时一种跪拜礼。稽此处读 qǐ，不读 jī。"
            }
          ]
        },
        {
          "id": "jz_g2",
          "title": "词语与成语（运用）",
          "words": [
            {
              "id": "jz_011",
              "word": "因地制宜",
              "pinyin": "yīn dì zhì yí",
              "bushou": "囗",
              "zuci": [
                "因地制宜"
              ],
              "juxing": "山区因地制宜发展林果业。",
              "jieshi": "根据不同地区的具体情况制定适宜的办法。"
            },
            {
              "id": "jz_012",
              "word": "锐不可当",
              "pinyin": "ruì bù kě dāng",
              "bushou": "钅",
              "zuci": [
                "锐不可当"
              ],
              "juxing": "我军攻势锐不可当。",
              "jieshi": "形容来势猛烈，不可阻挡。当读 dāng，不读 dǎng。"
            },
            {
              "id": "jz_013",
              "word": "恪尽职守",
              "pinyin": "kè jìn zhí shǒu",
              "bushou": "忄",
              "zuci": [
                "恪尽职守"
              ],
              "juxing": "他恪尽职守，二十年如一日。",
              "jieshi": "谨慎认真地做好本职工作。恪读 kè。"
            },
            {
              "id": "jz_014",
              "word": "相形见绌",
              "pinyin": "xiāng xíng jiàn chù",
              "bushou": "纟",
              "zuci": [
                "相形见绌"
              ],
              "juxing": "比起他的成就，我的努力相形见绌。",
              "jieshi": "相比之下显得不足。绌读 chù，不读 zhuó。"
            },
            {
              "id": "jz_015",
              "word": "锱铢必较",
              "pinyin": "zī zhū bì jiào",
              "bushou": "钅",
              "zuci": [
                "锱铢必较"
              ],
              "juxing": "他为人豁达，从不锱铢必较。",
              "jieshi": "对很小的利益也要计较，形容吝啬。"
            },
            {
              "id": "jz_016",
              "word": "罄竹难书",
              "pinyin": "qìng zhú nán shū",
              "bushou": "缶",
              "zuci": [
                "罄竹难书"
              ],
              "juxing": "侵略者的罪行罄竹难书。",
              "jieshi": "形容罪行多得写不完，多用于贬义。"
            },
            {
              "id": "jz_017",
              "word": "莘莘学子",
              "pinyin": "shēn shēn xué zǐ",
              "bushou": "艹",
              "zuci": [
                "莘莘学子"
              ],
              "juxing": "莘莘学子寒窗苦读。",
              "jieshi": "众多的学生。莘读 shēn，不读 xīn。"
            },
            {
              "id": "jz_018",
              "word": "一蹴而就",
              "pinyin": "yī cù ér jiù",
              "bushou": "足",
              "zuci": [
                "一蹴而就"
              ],
              "juxing": "成功不可能一蹴而就。",
              "jieshi": "形容事情轻而易举，一下子就能完成。蹴读 cù。"
            },
            {
              "id": "jz_019",
              "word": "毋庸赘言",
              "pinyin": "wú yōng zhuì yán",
              "bushou": "毋",
              "zuci": [
                "毋庸赘言"
              ],
              "juxing": "结论已明，毋庸赘言。",
              "jieshi": "不必多说。赘读 zhuì。"
            },
            {
              "id": "jz_020",
              "word": "鳞次栉比",
              "pinyin": "lín cì zhì bǐ",
              "bushou": "鱼",
              "zuci": [
                "鳞次栉比"
              ],
              "juxing": "江边高楼鳞次栉比。",
              "jieshi": "形容房屋等密集整齐地排列。栉读 zhì。"
            }
          ]
        }
      ]
    },
    "poem": {
      "title": "古诗文默写与赏析",
      "groups": [
        {
          "id": "jp_g1",
          "title": "必背默写（名句）",
          "poems": [
            {
              "id": "jp_001",
              "title": "观沧海",
              "dynasty": "东汉",
              "author": "曹操",
              "lines": [
                "东临碣石，以观沧海。",
                "水何澹澹，山岛竦峙。",
                "树木丛生，百草丰茂。",
                "秋风萧瑟，洪波涌起。",
                "日月之行，若出其中；",
                "星汉灿烂，若出其里。"
              ],
              "notes": [
                "澹澹：水波荡漾的样子。",
                "星汉：银河。"
              ]
            },
            {
              "id": "jp_002",
              "title": "次北固山下",
              "dynasty": "唐",
              "author": "王湾",
              "lines": [
                "客路青山外，行舟绿水前。",
                "潮平两岸阔，风正一帆悬。",
                "海日生残夜，江春入旧年。",
                "乡书何处达？归雁洛阳边。"
              ],
              "notes": [
                "残夜：夜将尽未尽之时。",
                "全诗格调昂扬，蕴含新生事物孕育于旧事物之中的理趣。"
              ]
            },
            {
              "id": "jp_003",
              "title": "钱塘湖春行",
              "dynasty": "唐",
              "author": "白居易",
              "lines": [
                "孤山寺北贾亭西，水面初平云脚低。",
                "几处早莺争暖树，谁家新燕啄春泥。",
                "乱花渐欲迷人眼，浅草才能没马蹄。",
                "最爱湖东行不足，绿杨阴里白沙堤。"
              ],
              "notes": [
                "没：遮没、盖没。",
                "早莺、新燕写出早春的生机。"
              ]
            },
            {
              "id": "jp_004",
              "title": "天净沙·秋思",
              "dynasty": "元",
              "author": "马致远",
              "lines": [
                "枯藤老树昏鸦，",
                "小桥流水人家，",
                "古道西风瘦马。",
                "夕阳西下，",
                "断肠人在天涯。"
              ],
              "notes": [
                "天净沙：曲牌名。",
                "全篇以景结情，被誉为“秋思之祖”。"
              ]
            },
            {
              "id": "jp_005",
              "title": "登幽州台歌",
              "dynasty": "唐",
              "author": "陈子昂",
              "lines": [
                "前不见古人，",
                "后不见来者。",
                "念天地之悠悠，",
                "独怆然而涕下！"
              ],
              "notes": [
                "幽州台：即蓟北楼。",
                "悠悠：渺远的样子。"
              ]
            },
            {
              "id": "jp_006",
              "title": "望岳",
              "dynasty": "唐",
              "author": "杜甫",
              "lines": [
                "岱宗夫如何？齐鲁青未了。",
                "造化钟神秀，阴阳割昏晓。",
                "荡胸生曾云，决眦入归鸟。",
                "会当凌绝顶，一览众山小。"
              ],
              "notes": [
                "岱宗：泰山别称。",
                "会当：终当、定要。"
              ]
            },
            {
              "id": "jp_007",
              "title": "饮酒（其五）",
              "dynasty": "东晋",
              "author": "陶渊明",
              "lines": [
                "结庐在人境，而无车马喧。",
                "问君何能尔？心远地自偏。",
                "采菊东篱下，悠然见南山。",
                "山气日夕佳，飞鸟相与还。"
              ],
              "notes": [
                "尔：如此。",
                "悠然：闲适淡泊的样子。"
              ]
            },
            {
              "id": "jp_008",
              "title": "行路难（其一）",
              "dynasty": "唐",
              "author": "李白",
              "lines": [
                "金樽清酒斗十千，玉盘珍羞直万钱。",
                "停杯投箸不能食，拔剑四顾心茫然。",
                "欲渡黄河冰塞川，将登太行雪满山。",
                "长风破浪会有时，直挂云帆济沧海。"
              ],
              "notes": [
                "箸：筷子。",
                "济：渡。结尾豪迈乐观。"
              ]
            },
            {
              "id": "jp_009",
              "title": "茅屋为秋风所破歌（节选）",
              "dynasty": "唐",
              "author": "杜甫",
              "lines": [
                "安得广厦千万间，",
                "大庇天下寒士俱欢颜，",
                "风雨不动安如山。",
                "呜呼！何时眼前突兀见此屋，",
                "吾庐独破受冻死亦足！"
              ],
              "notes": [
                "庇：遮盖、掩护。",
                "见：同“现”，出现。"
              ]
            },
            {
              "id": "jp_010",
              "title": "己亥杂诗（其五）",
              "dynasty": "清",
              "author": "龚自珍",
              "lines": [
                "浩荡离愁白日斜，",
                "吟鞭东指即天涯。",
                "落红不是无情物，",
                "化作春泥更护花。"
              ],
              "notes": [
                "落红：落花。",
                "以落花自喻，表达奉献精神。"
              ]
            }
          ]
        },
        {
          "id": "jp_g2",
          "title": "名句赏析",
          "poems": [
            {
              "id": "jp_011",
              "title": "使至塞上",
              "dynasty": "唐",
              "author": "王维",
              "lines": [
                "单车欲问边，属国过居延。",
                "征蓬出汉塞，归雁入胡天。",
                "大漠孤烟直，长河落日圆。",
                "萧关逢候骑，都护在燕然。"
              ],
              "notes": [
                "“大漠孤烟直，长河落日圆”构图壮阔，被誉为“千古壮观”。"
              ]
            },
            {
              "id": "jp_012",
              "title": "春望",
              "dynasty": "唐",
              "author": "杜甫",
              "lines": [
                "国破山河在，城春草木深。",
                "感时花溅泪，恨别鸟惊心。",
                "烽火连三月，家书抵万金。",
                "白头搔更短，浑欲不胜簪。"
              ],
              "notes": [
                "抵：值、相当。",
                "以乐景写哀情，忧国忧民。"
              ]
            },
            {
              "id": "jp_013",
              "title": "酬乐天扬州初逢席上见赠",
              "dynasty": "唐",
              "author": "刘禹锡",
              "lines": [
                "巴山楚水凄凉地，二十三年弃置身。",
                "怀旧空吟闻笛赋，到乡翻似烂柯人。",
                "沉舟侧畔千帆过，病树前头万木春。",
                "今日听君歌一曲，暂凭杯酒长精神。"
              ],
              "notes": [
                "“沉舟侧畔千帆过”蕴含新事物必将取代旧事物的哲理。"
              ]
            },
            {
              "id": "jp_014",
              "title": "水调歌头",
              "dynasty": "宋",
              "author": "苏轼",
              "lines": [
                "明月几时有？把酒问青天。",
                "人有悲欢离合，月有阴晴圆缺，",
                "此事古难全。",
                "但愿人长久，千里共婵娟。"
              ],
              "notes": [
                "婵娟：这里指月亮。",
                "表达旷达的祝愿。"
              ]
            },
            {
              "id": "jp_015",
              "title": "山坡羊·潼关怀古",
              "dynasty": "元",
              "author": "张养浩",
              "lines": [
                "峰峦如聚，波涛如怒，",
                "山河表里潼关路。",
                "兴，百姓苦；亡，百姓苦。"
              ],
              "notes": [
                "曲牌名山坡羊。",
                "结尾直抒对百姓疾苦的同情。"
              ]
            },
            {
              "id": "jp_016",
              "title": "过零丁洋",
              "dynasty": "宋",
              "author": "文天祥",
              "lines": [
                "辛苦遭逢起一经，干戈寥落四周星。",
                "山河破碎风飘絮，身世浮沉雨打萍。",
                "人生自古谁无死？留取丹心照汗青。"
              ],
              "notes": [
                "汗青：史册。",
                "丹心：红心，比喻忠心。"
              ]
            },
            {
              "id": "jp_017",
              "title": "渔家傲·秋思",
              "dynasty": "宋",
              "author": "范仲淹",
              "lines": [
                "塞下秋来风景异，衡阳雁去无留意。",
                "浊酒一杯家万里，燕然未勒归无计。",
                "羌管悠悠霜满地。"
              ],
              "notes": [
                "燕然未勒：功业未成。",
                "边塞词，苍凉悲壮。"
              ]
            },
            {
              "id": "jp_018",
              "title": "破阵子·为陈同甫赋壮词以寄之",
              "dynasty": "宋",
              "author": "辛弃疾",
              "lines": [
                "醉里挑灯看剑，梦回吹角连营。",
                "了却君王天下事，赢得生前身后名。",
                "可怜白发生！"
              ],
              "notes": [
                "壮词：豪迈的词。",
                "梦境与现实对照，壮志未酬。"
              ]
            }
          ]
        }
      ]
    },
    "guwen": {
      "title": "文言文阅读",
      "groups": [
        {
          "id": "jg_g1",
          "title": "课内文言文（精讲）",
          "passages": [
            {
              "id": "jg_001",
              "title": "《论语》十二章（节选）",
              "source": "《论语》",
              "lines": [
                "子曰：“学而时习之，不亦说乎？",
                "子曰：“温故而知新，可以为师矣。”",
                "子曰：“学而不思则罔，思而不学则殆。”",
                "子曰：“三人行，必有我师焉。”"
              ],
              "zhushi": {
                "说": "同“悦”，愉快。",
                "罔": "迷惑，意思是感到迷茫而无所适从。",
                "殆": "疑惑。",
                "焉": "于此，意思是在其中。"
              },
              "fanyi": "孔子说：“学了知识按时温习，不也很愉快吗？”又说：“温习旧知识能有新体会，就可以做老师了。”强调学思结合。",
              "kaodian": [
                {
                  "q": "“学而不思则罔”中“罔”的意思是？",
                  "options": [
                    "迷惑",
                    "收获",
                    "快乐",
                    "忘记"
                  ],
                  "answer": 0,
                  "analysis": "罔：迷惑，指只学不思会迷茫无所适从。"
                },
                {
                  "q": "“三人行，必有我师焉”说明学习应？",
                  "options": [
                    "闭门造车",
                    "虚心向别人学习",
                    "只信自己",
                    "轻视他人"
                  ],
                  "answer": 1,
