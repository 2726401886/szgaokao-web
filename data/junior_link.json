      "title": "代词",
      "grammar": [
        {
          "point": "主格做主语：I / you / he / she / it / we / they",
          "example": "I like English. They are my friends.",
          "cn": "我喜欢英语。他们是我的朋友。",
          "audio": "/audio/jl/jl3-g1.mp3"
        },
        {
          "point": "宾格做宾语：me / you / him / her / it / us / them",
          "example": "Please help me. I like her.",
          "cn": "请帮帮我。我喜欢她。",
          "audio": "/audio/jl/jl3-g2.mp3"
        },
