        {
          "point": "规则复数：一般加 -s；s/x/ch/sh 结尾加 -es",
          "example": "book → books; box → boxes; watch → watches",
          "cn": "书；盒子；手表。",
          "audio": "/audio/jl/jl2-g1.mp3"
        },
        {
          "point": "辅音字母 + y 结尾：变 y 为 i 加 -es",
          "example": "city → cities; baby → babies",
          "cn": "城市；婴儿。",
          "audio": "/audio/jl/jl2-g2.mp3"
        },
        {
          "point": "不规则复数要牢记",
          "example": "man → men; child → children; foot → feet",
          "cn": "男人；孩子；脚。",
          "audio": "/audio/jl/jl2-g3.mp3"
