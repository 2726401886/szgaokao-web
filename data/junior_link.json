      "id": "jl1",
      "title": "be 动词与自我介绍",
      "grammar": [
        {
          "point": "be 动词三兄弟：am / is / are",
          "example": "I am Tom. You are my friend. He is a pupil.",
          "cn": "我是汤姆。你是我的朋友。他是小学生。",
          "audio": "/audio/jl/jl1-g1.mp3"
        },
        {
          "point": "I 用 am，he/she/it 用 is，you/we/they 用 are",
          "example": "She is a teacher. We are students.",
          "cn": "她是老师。我们是学生。",
          "audio": "/audio/jl/jl1-g2.mp3"
        }
      ],
